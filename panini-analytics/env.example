# Copia este archivo a .env y completa los valores.

# Clave de la API de Anthropic (se usa en Fase 3: chat NL->SQL)
ANTHROPIC_API_KEY=sk-ant-...

# Clave de sesión de Flask. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciales de acceso (se usan en Fase 4: autenticación)
APP_USER=
APP_PASS=

# Ruta de la base SQLite persistente
DB_PATH=data/ventas.db

# Puerto local (opcional)
PORT=5000
